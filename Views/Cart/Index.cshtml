@model List<Shoping_webapplication_project_.Models.CartItem>

@{
    ViewBag.Title = "Shopping Cart";
    Layout = "~/Views/Shared/UserDashboardLayout.cshtml";

    decimal subTotal = Model != null ? Model.Sum(i => i.TotalPrice) : 0;
    int totalItems = Model != null ? Model.Sum(i => i.Quantity) : 0;
}

<style>
    .cart-title-row {
        display: flex;
        align-items: center;
        justify-content: space-between;
        margin-bottom: 25px;
    }

    .cart-title-row h1 {
        font-size: 26px;
        font-weight: 800;
        margin: 0;
        color: #111;
    }

    .cart-layout {
        display: grid;
        grid-template-columns: 1fr 340px;
        gap: 25px;
        align-items: start;
    }

    /* Cart Items Table / Card */
    .cart-table-card {
        background: #fff;
        border-radius: 20px;
        padding: 25px;
        border: 1px solid rgba(0, 0, 0, 0.06);
        box-shadow: 0 4px 20px rgba(0, 0, 0, 0.03);
    }

    .cart-item-row {
        display: grid;
        grid-template-columns: 80px 1fr auto auto auto;
        gap: 18px;
        align-items: center;
        padding: 16px 0;
        border-bottom: 1px solid #f0f0f0;
    }

    .cart-item-row:last-child {
        border-bottom: none;
    }

    .cart-item-img {
        width: 80px;
        height: 80px;
        background: #f7f7f8;
        border-radius: 12px;
        overflow: hidden;
        display: flex;
        align-items: center;
        justify-content: center;
    }

    .cart-item-img img {
        width: 100%;
        height: 100%;
        object-fit: cover;
    }

    .cart-item-info h4 {
        margin: 0 0 5px;
        font-size: 15px;
        font-weight: 700;
        color: #111;
    }

    .cart-item-info span {
        font-size: 12px;
        color: #888;
    }

    .cart-item-qty {
        display: flex;
        align-items: center;
        border: 1px solid #ddd;
        border-radius: 8px;
        overflow: hidden;
    }

    .cart-qty-btn {
        background: #f5f5f5;
        border: none;
        width: 32px;
        height: 32px;
        font-size: 14px;
        font-weight: 700;
        cursor: pointer;
        display: flex;
        align-items: center;
        justify-content: center;
    }

    .cart-qty-btn:hover {
        background: #e5e5e5;
    }

    .cart-qty-val {
        padding: 0 10px;
        font-size: 13px;
        font-weight: 700;
    }

    .cart-item-total {
        font-size: 16px;
        font-weight: 800;
        color: #e50914;
        min-width: 90px;
        text-align: right;
    }

    .cart-remove-btn {
        background: transparent;
        border: none;
        color: #999;
        cursor: pointer;
        font-size: 18px;
        padding: 5px;
        transition: 0.2s ease;
    }

    .cart-remove-btn:hover {
        color: #e50914;
    }

    /* Summary Card */
    .summary-card {
        background: #fff;
        border-radius: 20px;
        padding: 25px;
        border: 1px solid rgba(0, 0, 0, 0.06);
        box-shadow: 0 4px 20px rgba(0, 0, 0, 0.03);
    }

    .summary-card h3 {
        margin: 0 0 20px;
        font-size: 18px;
        font-weight: 800;
        color: #111;
    }

    .summary-line {
        display: flex;
        align-items: center;
        justify-content: space-between;
        font-size: 13px;
        color: #666;
        margin-bottom: 12px;
    }

    .summary-line.total-line {
        border-top: 1px solid #eee;
        padding-top: 15px;
        margin-top: 15px;
        font-size: 16px;
        font-weight: 800;
        color: #111;
    }

    .summary-line.total-line span:last-child {
        color: #e50914;
        font-size: 20px;
    }

    .btn-checkout {
        display: block;
        width: 100%;
        padding: 13px;
        background: #e50914;
        color: #fff;
        text-align: center;
        border-radius: 12px;
        font-size: 14px;
        font-weight: 700;
        text-decoration: none;
        margin-top: 20px;
        transition: 0.2s ease;
        box-shadow: 0 6px 20px rgba(229, 9, 20, 0.3);
    }

    .btn-checkout:hover {
        background: #b20710;
        color: #fff;
        transform: translateY(-2px);
    }

    .btn-continue-shop {
        display: block;
        width: 100%;
        text-align: center;
        font-size: 12px;
        font-weight: 700;
        color: #555;
        margin-top: 12px;
        text-decoration: none;
    }

    .btn-continue-shop:hover {
        color: #e50914;
    }

    /* Empty Cart State */
    .empty-cart-card {
        background: #fff;
        border-radius: 20px;
        padding: 60px 20px;
        text-align: center;
        border: 1px dashed #ddd;
    }

    .empty-cart-card h3 {
        margin: 0 0 10px;
        font-size: 20px;
        color: #111;
    }

    .empty-cart-card p {
        color: #777;
        font-size: 13px;
        margin: 0 0 25px;
    }

    @@media (max-width: 900px) {
        .cart-layout {
            grid-template-columns: 1fr;
        }
        .cart-item-row {
            grid-template-columns: 60px 1fr auto;
            gap: 12px;
        }
        .cart-item-total {
            grid-column: span 3;
            text-align: left;
        }
    }
</style>

<div class="cart-title-row">
    <h1>Shopping Cart (@totalItems Items)</h1>

    @if (Model != null && Model.Any())
    {
        using (Html.BeginForm("Clear", "Cart", FormMethod.Post))
        {
            <button type="submit" class="cart-remove-btn" style="font-size:12px;font-weight:700;" onclick="return confirm('Are you sure you want to clear your cart?');">
                Clear Cart
            </button>
        }
    }
</div>

@if (Model != null && Model.Any())
{
    <div class="cart-layout">

        <!-- Left: Cart Items -->
        <div class="cart-table-card">
            @foreach (var item in Model)
            {
                <div class="cart-item-row">
                    <div class="cart-item-img">
                        @if (!string.IsNullOrEmpty(item.ImageUrl))
                        {
                            <img src="@Url.Content(item.ImageUrl)" alt="@item.ProductName" />
                        }
                        else
                        {
                            <div style="font-size:10px;color:#999;">No Image</div>
                        }
                    </div>

                    <div class="cart-item-info">
                        <h4>@item.ProductName</h4>
                        <span>Unit Price: &#8377;@item.Price.ToString("N2")</span>
                    </div>

                    <!-- Quantity Control -->
                    <div class="cart-item-qty">
                        @using (Html.BeginForm("UpdateQuantity", "Cart", FormMethod.Post, new { style = "display:inline;" }))
                        {
                            <input type="hidden" name="productId" value="@item.ProductId" />
                            <input type="hidden" name="actionType" value="decrease" />
                            <button type="submit" class="cart-qty-btn">-</button>
                        }

                        <span class="cart-qty-val">@item.Quantity</span>

                        @using (Html.BeginForm("UpdateQuantity", "Cart", FormMethod.Post, new { style = "display:inline;" }))
                        {
                            <input type="hidden" name="productId" value="@item.ProductId" />
                            <input type="hidden" name="actionType" value="increase" />
                            <button type="submit" class="cart-qty-btn" @(item.Quantity >= item.StockQuantity ? "disabled" : "")>+</button>
                        }
                    </div>

                    <!-- Total Price -->
                    <div class="cart-item-total">
                        &#8377;@item.TotalPrice.ToString("N2")
                    </div>

                    <!-- Remove Button -->
                    @using (Html.BeginForm("Remove", "Cart", FormMethod.Post, new { style = "display:inline;" }))
                    {
                        <input type="hidden" name="productId" value="@item.ProductId" />
                        <button type="submit" class="cart-remove-btn" title="Remove item">&times;</button>
                    }
                </div>
            }
        </div>

        <!-- Right: Summary -->
        <div class="summary-card">
            <h3>Order Summary</h3>

            <div class="summary-line">
                <span>Items Count</span>
                <span>@totalItems</span>
            </div>

            <div class="summary-line">
                <span>Subtotal</span>
                <span>&#8377;@subTotal.ToString("N2")</span>
            </div>

            <div class="summary-line">
                <span>Delivery Charges</span>
                <span style="color:#1a8742;font-weight:700;">FREE</span>
            </div>

            <div class="summary-line total-line">
                <span>Total Amount</span>
                <span>&#8377;@subTotal.ToString("N2")</span>
            </div>
            <a href="@Url.Action("Checkout", "Cart")" class="btn-checkout">
                Proceed to Checkout →
            </a>
            <a href="@Url.Action("Index", "Product")" class="btn-continue-shop">
                ← Continue Shopping
            </a>
        </div>

    </div>
}
else
{
    <div class="empty-cart-card">
        <h3>Your Cart is Empty</h3>
        <p>Looks like you haven't added any items to your shopping cart yet.</p>
        <a href="@Url.Action("Index", "Product")" class="btn-checkout" style="display:inline-block;width:auto;padding:10px 25px;">
            Start Shopping →
        </a>
    </div>
}
@model List<Shoping_webapplication_project_.Models.CartItem>
@{
    ViewBag.Title = "My Wishlist";
    Layout = "~/Views/Shared/UserDashboardLayout.cshtml";
}


<style>
    .wishlist-head {
        margin-bottom: 25px;
    }

        .wishlist-head h1 {
            font-size: 26px;
            font-weight: 800;
            margin: 0 0 5px;
            color: #111;
        }

        .wishlist-head p {
            margin: 0;
            font-size: 13px;
            color: #777;
        }

    .wishlist-grid {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(260px, 1fr));
        gap: 22px;
    }

    .wishlist-card {
        background: #fff;
        border-radius: 18px;
        overflow: hidden;
        border: 1px solid rgba(0, 0, 0, 0.06);
        box-shadow: 0 4px 18px rgba(0, 0, 0, 0.03);
        display: flex;
        flex-direction: column;
        transition: 0.2s ease;
        position: relative;
    }

        .wishlist-card:hover {
            transform: translateY(-4px);
            box-shadow: 0 10px 25px rgba(0, 0, 0, 0.08);
            border-color: rgba(229, 9, 20, 0.2);
        }

    .wishlist-img-box {
        width: 100%;
        height: 200px;
        background: #f7f7f8;
        display: flex;
        align-items: center;
        justify-content: center;
    }

        .wishlist-img-box img {
            width: 100%;
            height: 100%;
            object-fit: cover;
        }

    .wishlist-info {
        padding: 16px;
        display: flex;
        flex-direction: column;
        flex: 1;
    }

    .wishlist-name {
        font-size: 14px;
        font-weight: 700;
        color: #111;
        margin: 0 0 8px;
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
    }

    .wishlist-price {
        font-size: 17px;
        font-weight: 800;
        color: #e50914;
        margin-bottom: 15px;
    }

    .wishlist-actions {
        display: flex;
        gap: 8px;
        padding: 0 16px 16px;
    }

    .btn-move-cart {
        flex: 1;
        background: #e50914;
        color: #fff;
        border: none;
        padding: 9px 0;
        border-radius: 8px;
        font-size: 12px;
        font-weight: 700;
        cursor: pointer;
        transition: 0.2s ease;
    }

        .btn-move-cart:hover {
            background: #b20710;
        }

    .btn-remove-wishlist {
        background: #f5f5f5;
        color: #666;
        border: 1px solid #ddd;
        padding: 9px 14px;
        border-radius: 8px;
        font-size: 14px;
        cursor: pointer;
        transition: 0.2s ease;
    }

        .btn-remove-wishlist:hover {
            color: #e50914;
            border-color: #e50914;
        }

    .empty-wishlist {
        background: #fff;
        border-radius: 20px;
        padding: 60px 20px;
        text-align: center;
        border: 1px dashed #ddd;
    }

        .empty-wishlist h3 {
            margin: 0 0 8px;
            font-size: 18px;
            color: #111;
        }

        .empty-wishlist p {
            color: #777;
            font-size: 13px;
            margin: 0 0 20px;
        }
</style>

<div class="wishlist-head">
    <h1>My Wishlist (@Model.Count Items)</h1>
    <p>Your saved favorites to buy later or move to your shopping cart.</p>
</div>

@if (Model != null && Model.Any())
{
    <div class="wishlist-grid">
        @foreach (var item in Model)
        {
            <div class="wishlist-card">
                <div class="wishlist-img-box">
                    @if (!string.IsNullOrEmpty(item.ImageUrl))
                    {
                        <img src="@Url.Content(item.ImageUrl)" alt="@item.ProductName" />
                    }
                    else
                    {
                        <div style="font-size:11px;color:#999;">No Image Available</div>
                    }
                </div>

                <div class="wishlist-info">
                    <h4 class="wishlist-name" title="@item.ProductName">@item.ProductName</h4>
                    <div class="wishlist-price">&#8377;@item.Price.ToString("N2")</div>
                </div>

                <div class="wishlist-actions">
                    @using (Html.BeginForm("MoveToCart", "Wishlist", FormMethod.Post, new { style = "flex:1;" }))
                    {
                        <input type="hidden" name="productId" value="@item.ProductId" />
                        <button type="submit" class="btn-move-cart">Move to Cart</button>
                    }

                    @using (Html.BeginForm("Remove", "Wishlist", FormMethod.Post))
                    {
                        <input type="hidden" name="productId" value="@item.ProductId" />
                        <button type="submit" class="btn-remove-wishlist" title="Remove from Wishlist">&times;</button>
                    }
                </div>
            </div>
        }
    </div>
}
else
{
    <div class="empty-wishlist">
        <h3>Your Wishlist is Empty</h3>
        <p>Save items you like by clicking the Wishlist button on products.</p>
        <a href="@Url.Action("Index", "Product")" class="btn-move-cart" style="display:inline-block;padding:10px 24px;text-decoration:none;">
            Explore Products
        </a>
    </div>
}


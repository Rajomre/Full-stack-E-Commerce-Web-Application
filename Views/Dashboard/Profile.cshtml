@model Shoping_webapplication_project_.Models.User

@{
    ViewBag.Title = "My Profile";
    Layout = "~/Views/Shared/UserDashboardLayout.cshtml";
}

<style>
    .profile-title-row {
        margin-bottom: 25px;
    }

        .profile-title-row h1 {
            font-size: 26px;
            font-weight: 800;
            margin: 0 0 5px;
            color: #111;
        }

        .profile-title-row p {
            margin: 0;
            font-size: 13px;
            color: #777;
        }

    .profile-grid {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 25px;
        align-items: start;
    }

    .profile-card {
        background: #fff;
        border-radius: 20px;
        padding: 30px;
        border: 1px solid rgba(0, 0, 0, 0.06);
        box-shadow: 0 4px 20px rgba(0, 0, 0, 0.03);
    }

        .profile-card h3 {
            margin: 0 0 20px;
            font-size: 18px;
            font-weight: 800;
            color: #111;
            padding-bottom: 12px;
            border-bottom: 1px solid #f0f0f0;
        }

    .avatar-preview-box {
        display: flex;
        align-items: center;
        gap: 16px;
        margin-bottom: 25px;
        padding: 16px;
        border-radius: 14px;
        background: #f8f9fa;
    }

    .avatar-big {
        width: 55px;
        height: 55px;
        border-radius: 50%;
        background: #111;
        color: #fff;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 22px;
        font-weight: 800;
        box-shadow: 0 4px 15px rgba(0,0,0,0.15);
    }

    .avatar-text strong {
        display: block;
        font-size: 16px;
        color: #111;
    }

    .avatar-text span {
        display: inline-block;
        font-size: 11px;
        font-weight: 700;
        padding: 3px 8px;
        border-radius: 6px;
        background: rgba(229, 9, 20, 0.1);
        color: #e50914;
        margin-top: 4px;
    }

    .form-group {
        margin-bottom: 18px;
    }

        .form-group label {
            display: block;
            font-size: 12px;
            font-weight: 700;
            color: #444;
            margin-bottom: 6px;
        }

    .form-control-custom {
        width: 100%;
        height: 44px;
        padding: 0 14px;
        border-radius: 10px;
        border: 1px solid #ddd;
        font-size: 13px;
        outline: none;
        transition: 0.2s ease;
    }

        .form-control-custom:focus {
            border-color: #e50914;
        }

    .btn-save-profile {
        height: 44px;
        padding: 0 24px;
        background: #e50914;
        color: #fff;
        border: none;
        border-radius: 10px;
        font-size: 13px;
        font-weight: 700;
        cursor: pointer;
        transition: 0.2s ease;
        box-shadow: 0 4px 15px rgba(229, 9, 20, 0.3);
    }

        .btn-save-profile:hover {
            background: #b20710;
            transform: translateY(-2px);
        }

    .alert-msg {
        padding: 12px 16px;
        border-radius: 10px;
        font-size: 13px;
        font-weight: 600;
        margin-bottom: 20px;
    }

    .alert-success {
        background: #e8f7ee;
        color: #1a8742;
        border: 1px solid #c2ebd1;
    }

    .alert-danger {
        background: #fde8e8;
        color: #e50914;
        border: 1px solid #f9c5c5;
    }

    @@media (max-width: 900px) {
        .profile-grid {
            grid-template-columns: 1fr;
        }
    }
</style>

<div class="profile-title-row">
    <h1>Account Settings</h1>
    <p>Manage your personal profile information and update account security.</p>
</div>

<div class="profile-grid">

    <!-- Left: Personal Info -->
    <div class="profile-card">
        <h3>Personal Information</h3>

        @if (TempData["ProfileSuccess"] != null)
        {
            <div class="alert-msg alert-success">@TempData["ProfileSuccess"]</div>
        }
        @if (TempData["ProfileError"] != null)
        {
            <div class="alert-msg alert-danger">@TempData["ProfileError"]</div>
        }

        <div class="avatar-preview-box">
            <div class="avatar-big">
                @(string.IsNullOrEmpty(Model.FullName) ? "U" : Model.FullName.Substring(0, 1).ToUpper())
            </div>
            <div class="avatar-text">
                <strong>@Model.FullName</strong>
                <span>Role: @Model.Role</span>
            </div>
        </div>

        @using (Html.BeginForm("UpdateProfile", "Dashboard", FormMethod.Post))
        {
            @Html.AntiForgeryToken()

            <div class="form-group">
                <label>Full Name *</label>
                <input type="text" name="fullName" class="form-control-custom" value="@Model.FullName" required />
            </div>

            <div class="form-group">
                <label>Email Address (Cannot be changed)</label>
                <input type="email" class="form-control-custom" value="@Model.Email" readonly style="background:#f7f7f8;color:#777;" />
            </div>

            <div class="form-group">
                <label>Phone Number</label>
                <input type="text" name="phone" class="form-control-custom" value="@Model.Phone" placeholder="Enter contact number" />
            </div>

            <button type="submit" class="btn-save-profile">
                Save Changes
            </button>
        }
    </div>

    <!-- Right: Change Password -->
    <div class="profile-card">
        <h3>Change Password</h3>

        @if (TempData["PasswordSuccess"] != null)
        {
            <div class="alert-msg alert-success">@TempData["PasswordSuccess"]</div>
        }
        @if (TempData["PasswordError"] != null)
        {
            <div class="alert-msg alert-danger">@TempData["PasswordError"]</div>
        }

        @using (Html.BeginForm("ChangePassword", "Dashboard", FormMethod.Post))
        {
            @Html.AntiForgeryToken()

            <div class="form-group">
                <label>Current Password *</label>
                <input type="password" name="currentPassword" class="form-control-custom" placeholder="Enter current password" required />
            </div>

            <div class="form-group">
                <label>New Password * (Min. 6 characters)</label>
                <input type="password" name="newPassword" class="form-control-custom" placeholder="Enter new password" required />
            </div>

            <div class="form-group">
                <label>Confirm New Password *</label>
                <input type="password" name="confirmPassword" class="form-control-custom" placeholder="Re-enter new password" required />
            </div>

            <button type="submit" class="btn-save-profile" style="background:#111;">
                Update Password
            </button>
        }
    </div>

</div>
@{
    var fullName = Convert.ToString(Session["FullName"]);
    var role = Convert.ToString(Session["Role"]);

    // Real Cart Count
    var cart = Session["Cart"] as List<Shoping_webapplication_project_.Models.CartItem>;
    int cartCount = cart != null ? cart.Sum(i => i.Quantity) : 0;

    // Real Wishlist Count
    var wishlist = Session["Wishlist"] as List<Shoping_webapplication_project_.Models.CartItem>;
    int wishlistCount = wishlist != null ? wishlist.Count : 0;
}

<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewBag.Title - Shopping Application</title>

    @Styles.Render("~/Content/css")

    <style>
        * {
            box-sizing: border-box;
        }

        html, body {
            margin: 0;
            padding: 0;
            min-height: 100%;
            font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, "Helvetica Neue", Arial, sans-serif;
            background: #080808;
            color: #111;
        }

        a {
            text-decoration: none;
            color: inherit;
        }

        .user-app {
            min-height: 100vh;
            display: flex;
            background: radial-gradient(circle at 90% 10%, rgba(229, 9, 20, 0.12), transparent 30%), radial-gradient(circle at 10% 90%, rgba(229, 9, 20, 0.05), transparent 25%), #0d0d0d;
        }

        /* SIDEBAR */
        .user-sidebar {
            width: 260px;
            min-height: 100vh;
            padding: 24px 16px;
            position: fixed;
            left: 0;
            top: 0;
            bottom: 0;
            z-index: 1000;
            background: rgba(14, 14, 14, 0.88);
            border-right: 1px solid rgba(255, 255, 255, 0.08);
            backdrop-filter: blur(20px);
            -webkit-backdrop-filter: blur(20px);
            display: flex;
            flex-direction: column;
            box-shadow: 10px 0 35px rgba(0, 0, 0, 0.5);
        }

        .user-brand {
            display: flex;
            align-items: center;
            gap: 12px;
            padding: 0 10px 24px;
            border-bottom: 1px solid rgba(255, 255, 255, 0.06);
            margin-bottom: 16px;
        }

        .brand-mark {
            width: 42px;
            height: 42px;
            display: flex;
            align-items: center;
            justify-content: center;
            border-radius: 12px;
            background: linear-gradient(135deg, #e50914, #990000);
            color: #fff;
            font-weight: 800;
            font-size: 16px;
            box-shadow: 0 6px 20px rgba(229, 9, 20, 0.35);
        }

        .brand-name strong {
            display: block;
            color: #fff;
            font-size: 16px;
            letter-spacing: 0.3px;
        }

        .brand-name span {
            display: block;
            color: #e50914;
            font-size: 10px;
            font-weight: 700;
            letter-spacing: 1.5px;
        }

        .sidebar-section-title {
            color: #666;
            font-size: 10px;
            font-weight: 700;
            letter-spacing: 1.4px;
            padding: 10px 12px 6px;
            text-transform: uppercase;
        }

        .user-nav {
            display: flex;
            flex-direction: column;
            gap: 4px;
        }

            .user-nav a {
                min-height: 44px;
                display: flex;
                align-items: center;
                gap: 12px;
                padding: 0 14px;
                border-radius: 10px;
                color: #aaa;
                font-size: 13px;
                font-weight: 500;
                transition: all 0.2s ease;
            }

                .user-nav a:hover {
                    color: #fff;
                    background: rgba(255, 255, 255, 0.06);
                    transform: translateX(3px);
                }

                .user-nav a.active {
                    color: #fff;
                    background: linear-gradient(135deg, #e50914, #b20710);
                    box-shadow: 0 6px 20px rgba(229, 9, 20, 0.3);
                }

            .user-nav svg {
                width: 18px;
                height: 18px;
                fill: currentColor;
                opacity: 0.9;
            }

        .sidebar-bottom {
            margin-top: auto;
            padding-top: 15px;
        }

        .member-banner {
            padding: 16px;
            border-radius: 14px;
            background: linear-gradient(135deg, rgba(229, 9, 20, 0.15), rgba(255, 255, 255, 0.02));
            border: 1px solid rgba(229, 9, 20, 0.25);
            color: #fff;
        }

            .member-banner strong {
                display: block;
                font-size: 13px;
                margin-bottom: 4px;
            }

            .member-banner p {
                margin: 0 0 10px;
                color: #888;
                font-size: 11px;
                line-height: 1.4;
            }

            .member-banner a {
                display: inline-block;
                background: #e50914;
                color: #fff;
                padding: 6px 12px;
                border-radius: 6px;
                font-size: 11px;
                font-weight: 600;
            }

        /* MAIN CONTENT */
        .user-main {
            width: calc(100% - 260px);
            margin-left: 260px;
            min-height: 100vh;
            padding: 24px 30px 40px;
            background: #f8f9fa;
        }

        /* TOPBAR */
        .user-topbar {
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 20px;
            margin-bottom: 25px;
        }

        /* WORKING SEARCH FORM */
        .search-form-topbar {
            flex: 1;
            max-width: 520px;
            margin: 0;
        }

        .search-bar {
            width: 100%;
            height: 46px;
            display: flex;
            align-items: center;
            gap: 10px;
            padding: 0 16px;
            border-radius: 12px;
            background: #fff;
            border: 1px solid rgba(0, 0, 0, 0.08);
            box-shadow: 0 4px 15px rgba(0, 0, 0, 0.03);
            transition: 0.2s ease;
        }

            .search-bar:focus-within {
                border-color: #e50914;
                box-shadow: 0 4px 20px rgba(229, 9, 20, 0.12);
            }

            .search-bar svg {
                width: 18px;
                height: 18px;
                fill: #888;
                flex-shrink: 0;
            }

            .search-bar input {
                border: none;
                outline: none;
                background: transparent;
                width: 100%;
                font-size: 13px;
                color: #222;
            }

        .top-nav-actions {
            display: flex;
            align-items: center;
            gap: 12px;
        }

        .top-action-btn {
            height: 46px;
            padding: 0 16px;
            display: flex;
            align-items: center;
            gap: 8px;
            border-radius: 12px;
            background: #fff;
            border: 1px solid rgba(0, 0, 0, 0.08);
            font-size: 13px;
            font-weight: 600;
            color: #333;
            box-shadow: 0 4px 15px rgba(0, 0, 0, 0.03);
            transition: all 0.2s ease;
        }

            .top-action-btn:hover {
                border-color: #e50914;
                color: #e50914;
            }

        .badge-count {
            background: #e50914;
            color: #fff;
            padding: 2px 7px;
            border-radius: 10px;
            font-size: 11px;
            font-weight: 700;
        }

        /* CLICKABLE USER PROFILE BADGE */
        .user-profile-badge-link {
            display: flex;
            align-items: center;
            gap: 10px;
            padding: 6px 14px;
            border-radius: 12px;
            background: #fff;
            border: 1px solid rgba(0, 0, 0, 0.08);
            box-shadow: 0 4px 15px rgba(0, 0, 0, 0.03);
            transition: all 0.2s ease;
            cursor: pointer;
        }

            .user-profile-badge-link:hover {
                border-color: #e50914;
                transform: translateY(-2px);
                box-shadow: 0 6px 20px rgba(0, 0, 0, 0.08);
            }

        .avatar-circle {
            width: 34px;
            height: 34px;
            border-radius: 50%;
            background: linear-gradient(135deg, #111, #333);
            color: #fff;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 13px;
            font-weight: 700;
        }

        .user-text-info strong {
            display: block;
            font-size: 12px;
            color: #111;
        }

        .user-text-info span {
            display: block;
            font-size: 10px;
            color: #e50914;
            font-weight: 600;
        }

        @@media (max-width: 992px) {
            .user-sidebar {
                width: 75px;
                padding: 20px 8px;
            }

            .user-main {
                width: calc(100% - 75px);
                margin-left: 75px;
                padding: 20px;
            }

            .brand-name, .sidebar-section-title, .user-nav span, .member-banner, .user-text-info {
                display: none;
            }

            .user-nav a {
                justify-content: center;
                padding: 0;
            }
        }

        @@media (max-width: 600px) {
            .user-sidebar {
                display: none;
            }

            .user-main {
                width: 100%;
                margin-left: 0;
                padding: 15px;
            }

            .user-topbar {
                flex-direction: column;
                align-items: stretch;
            }
        }
    </style>
</head>
<body>

    <div class="user-app">

        <!-- SIDEBAR -->
        <aside class="user-sidebar">

            <div class="user-brand">
                <div class="brand-mark">SA</div>
                <div class="brand-name">
                    <strong>Shopping</strong>
                    <span>USER PANEL</span>
                </div>
            </div>

            <div class="sidebar-section-title">Shop</div>
            <nav class="user-nav">
                <a href="@Url.Action("Index", "Dashboard")">
                    <svg viewBox="0 0 24 24"><path d="M10 20v-6h4v6h5v-8h3L12 3 2 12h3v8z" /></svg>
                    <span>Home</span>
                </a>
                <a href="@Url.Action("Index", "Product")">
                    <svg viewBox="0 0 24 24"><path d="M4 8h4V4H4v4zm6 12h4v-4h-4v4zm-6 0h4v-4H4v4zm0-6h4v-4H4v4zm6 0h4v-4h-4v4zm6-10v4h4V4h-4zm-6 4h4V4h-4v4zm6 6h4v-4h-4v4zm0 6h4v-4h-4v4z" /></svg>
                    <span>Categories</span>
                </a>
                <a href="@Url.Action("Index", "Product")">
                    <svg viewBox="0 0 24 24"><path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z" /></svg>
                    <span>New Arrivals</span>
                </a>
            </nav>

            <div class="sidebar-section-title">My Activity</div>
            <nav class="user-nav">
                <!-- Live Wishlist Link -->
                <a href="@Url.Action("Index", "Wishlist")">
                    <svg viewBox="0 0 24 24"><path d="M12 21.35l-1.45-1.32C5.4 15.36 2 12.28 2 8.5 2 5.42 4.42 3 7.5 3c1.74 0 3.41.81 4.5 2.09C13.09 3.81 14.76 3 16.5 3 19.58 3 22 5.42 22 8.5c0 3.78-3.4 6.86-8.55 11.54L12 21.35z" /></svg>
                    <span>Wishlist</span>
                    <span class="badge-count" style="margin-left: auto;">@wishlistCount</span>
                </a>

                <!-- Live Cart Link -->
                <a href="@Url.Action("Index", "Cart")">
                    <svg viewBox="0 0 24 24"><path d="M7 18c-1.1 0-1.99.9-1.99 2S5.9 22 7 22s2-.9 2-2-.9-2-2-2zM1 2v2h2l3.6 7.59-1.35 2.45c-.16.28-.25.61-.25.96 0 1.1.9 2 2 2h12v-2H7.42c-.14 0-.25-.11-.25-.25l.03-.12.9-1.63h7.45c.75 0 1.41-.41 1.75-1.03l3.58-6.49c.08-.14.12-.31.12-.48 0-.55-.45-1-1-1H5.21l-.94-2H1zm16 16c-1.1 0-1.99.9-1.99 2s.89 2 1.99 2 2-.9 2-2-.9-2-2-2z" /></svg>
                    <span>Cart</span>
                    <span class="badge-count" style="margin-left: auto;">@cartCount</span>
                </a>

                <a href="@Url.Action("Orders", "Dashboard")">
                    <svg viewBox="0 0 24 24"><path d="M19 3H5c-1.11 0-2 .9-2 2v14c0 1.1.89 2 2 2h14c1.1 0 2-.9 2-2V5c0-1.1-.9-2-2-2zm-2 10h-4v4h-2v-4H7v-2h4V7h2v4h4v2z" /></svg>
                    <span>My Orders</span>
                </a>
            </nav>

            <div class="sidebar-section-title">Settings</div>
            <nav class="user-nav">
                <a href="@Url.Action("Profile", "Dashboard")">
                    <svg viewBox="0 0 24 24"><path d="M12 12c2.21 0 4-1.79 4-4s-1.79-4-4-4-4 1.79-4 4 1.79 4 4 4zm0 2c-2.67 0-8 1.34-8 4v2h16v-2c0-2.66-5.33-4-8-4z" /></svg>
                    <span>My Profile</span>
                </a>
                <a href="@Url.Action("Logout", "Account")">
                    <svg viewBox="0 0 24 24"><path d="M17 7l-1.41 1.41L18.17 11H8v2h10.17l-2.58 2.58L17 17l5-5zM4 5h8V3H4c-1.1 0-2 .9-2 2v14c0 1.1.9 2 2 2h8v-2H4V5z" /></svg>
                    <span>Logout</span>
                </a>
            </nav>

            <div class="sidebar-bottom">
                <div class="member-banner">
                    <strong>Exclusive Deals</strong>
                    <p>Discover real hand-picked products today.</p>
                    <a href="@Url.Action("Index", "Product")">Shop Now →</a>
                </div>
            </div>

        </aside>

        <!-- MAIN AREA -->
        <main class="user-main">

            <!-- TOPBAR -->
            <div class="user-topbar">

                <!-- 1. LIVE WORKING SEARCH FORM -->
                @using (Html.BeginForm("Index", "Product", FormMethod.Get, new { @class = "search-form-topbar" }))
                {
                    <div class="search-bar">
                        <svg viewBox="0 0 24 24"><path d="M15.5 14h-.79l-.28-.27C15.41 12.59 16 11.11 16 9.5 16 5.91 13.09 3 9.5 3S3 5.91 3 9.5 5.91 16 9.5 16c1.61 0 3.09-.59 4.23-1.57l.27.28v.79l5 4.99L20.49 19l-4.99-5zm-6 0C7.01 14 5 11.99 5 9.5S7.01 5 9.5 5 14 7.01 14 9.5 11.99 14 9.5 14z" /></svg>
                        <input type="text" name="search" placeholder="Search products, brands and categories (Press Enter)..." value="@Request.QueryString["search"]" />
                    </div>
                }

                <div class="top-nav-actions">
                    <!-- Wishlist Topbar Button -->
                    <a href="@Url.Action("Index", "Wishlist")" class="top-action-btn">
                        <span>Wishlist</span>
                        <span class="badge-count">@wishlistCount</span>
                    </a>

                    <!-- Cart Topbar Button -->
                    <a href="@Url.Action("Index", "Cart")" class="top-action-btn">
                        <span>Cart</span>
                        <span class="badge-count">@cartCount</span>
                    </a>

                    <!-- 2. CLICKABLE USER PROFILE BADGE -->
                    <a href="@Url.Action("Profile", "Dashboard")" class="user-profile-badge-link" title="Click to view Account Settings">
                        <div class="avatar-circle">
                            @(string.IsNullOrEmpty(fullName) ? "U" : fullName.Substring(0, 1).ToUpper())
                        </div>
                        <div class="user-text-info">
                            <strong>@(string.IsNullOrEmpty(fullName) ? "Customer" : fullName)</strong>
                            <span>View Profile &rarr;</span>
                        </div>
                    </a>
                </div>
            </div>

            <!-- VIEW BODY -->
            <div class="user-page-content">
                @RenderBody()
            </div>

        </main>

    </div>

    @Scripts.Render("~/bundles/jquery")
    @Scripts.Render("~/bundles/bootstrap")
    @RenderSection("scripts", required: false)

</body>
</html>
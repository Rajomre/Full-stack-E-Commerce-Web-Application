@model Shoping_webapplication_project_.ViewModels.ForgotPasswordViewModel

@{
    ViewBag.Title = "Reset Password";
    Layout = "~/Views/Shared/LoginLayout.cshtml";
}

<style>
    .auth-wrapper {
        min-height: 80vh;
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 40px 15px;
    }

    .auth-card {
        width: 100%;
        max-width: 440px;
        background: #fff;
        border-radius: 22px;
        padding: 40px 35px;
        box-shadow: 0 15px 40px rgba(0, 0, 0, 0.08);
        border: 1px solid rgba(0, 0, 0, 0.06);
    }

    .auth-header {
        text-align: center;
        margin-bottom: 28px;
    }

    .auth-icon {
        width: 52px;
        height: 52px;
        border-radius: 14px;
        background: linear-gradient(135deg, #e50914, #990000);
        color: #fff;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 22px;
        font-weight: 800;
        margin: 0 auto 14px;
        box-shadow: 0 6px 20px rgba(229, 9, 20, 0.35);
    }

    .auth-header h2 {
        font-size: 22px;
        font-weight: 800;
        color: #111;
        margin: 0 0 6px;
    }

    .auth-header p {
        color: #777;
        font-size: 13px;
        margin: 0;
    }

    .form-group-custom {
        margin-bottom: 16px;
    }

        .form-group-custom label {
            display: block;
            font-size: 12px;
            font-weight: 700;
            color: #333;
            margin-bottom: 6px;
        }

    .input-custom {
        width: 100%;
        height: 44px;
        padding: 0 14px;
        border-radius: 10px;
        border: 1px solid #ddd;
        font-size: 13px;
        outline: none;
        transition: 0.2s ease;
        box-sizing: border-box;
    }

        .input-custom:focus {
            border-color: #e50914;
            box-shadow: 0 0 0 3px rgba(229, 9, 20, 0.1);
        }

    .btn-auth-submit {
        width: 100%;
        height: 46px;
        background: #e50914;
        color: #fff;
        border: none;
        border-radius: 10px;
        font-size: 14px;
        font-weight: 700;
        cursor: pointer;
        transition: 0.2s ease;
        box-shadow: 0 6px 20px rgba(229, 9, 20, 0.3);
        margin-top: 10px;
    }

        .btn-auth-submit:hover {
            background: #b20710;
            transform: translateY(-2px);
        }

    .auth-footer {
        text-align: center;
        margin-top: 22px;
        font-size: 13px;
        color: #666;
    }

        .auth-footer a {
            color: #e50914;
            font-weight: 700;
            text-decoration: none;
        }

            .auth-footer a:hover {
                text-decoration: underline;
            }

    .text-danger-msg {
        color: #e50914;
        font-size: 11px;
        font-weight: 600;
        display: block;
        margin-top: 4px;
    }

    .validation-summary-errors {
        background: #fde8e8;
        border: 1px solid #f9c5c5;
        border-radius: 10px;
        padding: 12px;
        color: #e50914;
        font-size: 12px;
        font-weight: 600;
        margin-bottom: 18px;
    }

        .validation-summary-errors ul {
            margin: 0;
            padding-left: 18px;
        }
</style>

<div class="auth-wrapper">
    <div class="auth-card">
        <div class="auth-header">
            <div class="auth-icon">&#128273;</div>
            <h2>Reset Your Password</h2>
            <p>Verify your details to set a new password</p>
        </div>

        @using (Html.BeginForm("ForgotPassword", "Account", FormMethod.Post))
        {
            @Html.AntiForgeryToken()
            @Html.ValidationSummary(true, "", new { @class = "validation-summary-errors" })

            <div class="form-group-custom">
                <label>Registered Email *</label>
                @Html.TextBoxFor(m => m.Email, new { @class = "input-custom", placeholder = "Enter your registered email", type = "email", required = "required" })
                @Html.ValidationMessageFor(m => m.Email, "", new { @class = "text-danger-msg" })
            </div>

            <div class="form-group-custom">
                <label>Registered Phone Number *</label>
                @Html.TextBoxFor(m => m.Phone, new { @class = "input-custom", placeholder = "Enter registered contact number", required = "required" })
                @Html.ValidationMessageFor(m => m.Phone, "", new { @class = "text-danger-msg" })
            </div>

            <div class="form-group-custom">
                <label>New Password * (Min. 6 chars)</label>
                @Html.PasswordFor(m => m.NewPassword, new { @class = "input-custom", placeholder = "Enter new password", required = "required" })
                @Html.ValidationMessageFor(m => m.NewPassword, "", new { @class = "text-danger-msg" })
            </div>

            <div class="form-group-custom">
                <label>Confirm New Password *</label>
                @Html.PasswordFor(m => m.ConfirmPassword, new { @class = "input-custom", placeholder = "Re-enter new password", required = "required" })
                @Html.ValidationMessageFor(m => m.ConfirmPassword, "", new { @class = "text-danger-msg" })
            </div>

            <button type="submit" class="btn-auth-submit">
                Reset Password &#10148;
            </button>

            <div class="auth-footer">
                Remember your password?
                <a href="@Url.Action("Login", "Account")">Back to Login</a>
            </div>
        }
    </div>
</div>
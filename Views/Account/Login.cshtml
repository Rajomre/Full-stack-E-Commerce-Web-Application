@model Shoping_webapplication_project_.ViewModels.LoginViewModel

@{
    Layout = "~/Views/Shared/LoginLayout.cshtml";
    ViewBag.Title = "Login";
}
@if (TempData["SuccessMessage"] != null)
{
    <div style="background:#e8f7ee;color:#1a8742;padding:12px 16px;border-radius:10px;font-size:13px;font-weight:600;margin-bottom:15px;border:1px solid #c2ebd1;">
        &#10003; @TempData["SuccessMessage"]
    </div>
}

<style>
    * {
        box-sizing: border-box;
    }

    .login-page {
        min-height: 100vh;
        display: flex;
        justify-content: center;
        align-items: center;
        padding: 40px 20px;
        background: linear-gradient(135deg, #fff5f5 0%, #f8f9fa 100%);
        font-family: "Segoe UI", Arial, sans-serif;
    }

    .login-card {
        width: 100%;
        max-width: 440px;
        background: #ffffff;
        border-radius: 18px;
        padding: 40px;
        box-shadow: 0 15px 45px rgba(0, 0, 0, 0.10);
        border: 1px solid rgba(229, 57, 53, 0.08);
    }

    /* Header */
    .login-header {
        text-align: center;
        margin-bottom: 30px;
    }

    .brand-icon {
        width: 58px;
        height: 58px;
        margin: 0 auto 15px;
        border-radius: 16px;
        background: linear-gradient(135deg, #e53935, #c62828);
        display: flex;
        align-items: center;
        justify-content: center;
        color: #fff;
        font-size: 24px;
        font-weight: 700;
        box-shadow: 0 8px 20px rgba(229, 57, 53, 0.25);
    }

    .login-header h1 {
        margin: 0;
        color: #222;
        font-size: 28px;
        font-weight: 700;
        letter-spacing: -0.5px;
    }

    .login-header p {
        margin: 8px 0 0;
        color: #777;
        font-size: 14px;
    }

    /* Validation */
    .validation-summary {
        margin-bottom: 18px;
        padding: 10px 12px;
        border-radius: 8px;
        background: #fff4f4;
        color: #d32f2f;
        font-size: 13px;
    }

    .text-danger {
        display: block;
        margin-top: 6px;
        color: #d32f2f;
        font-size: 12px;
    }

    /* Form */
    .form-group {
        margin-bottom: 20px;
    }

        .form-group label {
            display: block;
            margin-bottom: 8px;
            color: #333;
            font-size: 13px;
            font-weight: 600;
        }

    .input-wrapper {
        position: relative;
    }

    .input-icon {
        position: absolute;
        left: 14px;
        top: 50%;
        transform: translateY(-50%);
        color: #999;
        font-size: 15px;
        pointer-events: none;
    }

    .form-control {
        width: 100%;
        height: 49px;
        padding: 0 14px 0 42px;
        border: 1px solid #ddd;
        border-radius: 9px;
        outline: none;
        background: #fff;
        color: #333;
        font-size: 14px;
        transition: all 0.25s ease;
    }

        .form-control::placeholder {
            color: #aaa;
        }

        .form-control:hover {
            border-color: #bbb;
        }

        .form-control:focus {
            border-color: #e53935;
            box-shadow: 0 0 0 3px rgba(229, 57, 53, 0.10);
        }

    /* Forgot Password */
    .forgot-password {
        text-align: right;
        margin-top: -8px;
        margin-bottom: 22px;
    }

        .forgot-password a {
            color: #e53935;
            text-decoration: none;
            font-size: 13px;
            font-weight: 600;
        }

            .forgot-password a:hover {
                text-decoration: underline;
            }

    /* Login Button */
    .login-btn {
        width: 100%;
        height: 49px;
        border: none;
        border-radius: 9px;
        background: linear-gradient(135deg, #e53935, #c62828);
        color: #fff;
        font-size: 15px;
        font-weight: 600;
        letter-spacing: 0.2px;
        cursor: pointer;
        transition: all 0.25s ease;
        box-shadow: 0 7px 18px rgba(229, 57, 53, 0.20);
    }

        .login-btn:hover {
            transform: translateY(-1px);
            box-shadow: 0 10px 24px rgba(229, 57, 53, 0.28);
        }

        .login-btn:active {
            transform: translateY(0);
        }

    /* Register */
    .register-link {
        text-align: center;
        margin: 25px 0 0;
        padding-top: 22px;
        border-top: 1px solid #eee;
        color: #777;
        font-size: 14px;
    }

        .register-link a {
            color: #e53935;
            text-decoration: none;
            font-weight: 600;
            margin-left: 4px;
        }

            .register-link a:hover {
                text-decoration: underline;
            }

    /* Footer */
    .login-footer {
        text-align: center;
        margin-top: 18px;
        color: #aaa;
        font-size: 11px;
    }

    /* Responsive */
    @@media (max-width: 520px) {

        .login-page {
            padding: 20px 15px;
        }

        .login-card {
            padding: 30px 22px;
            border-radius: 15px;
        }

        .login-header h1 {
            font-size: 24px;
        }
    }
</style>


<div class="login-page">

    <div class="login-card">

        <!-- Header -->
        <div class="login-header">

            <div class="brand-icon">
                SA
            </div>

            <h1>Welcome Back</h1>

            <p>Login to your ShoppingApplication account</p>

        </div>


        @using (Html.BeginForm("Login", "Account", FormMethod.Post))
        {
            @Html.AntiForgeryToken()

            @Html.ValidationSummary(
                true,
                "",
                new { @class = "validation-summary" }
            )


            <!-- Email -->
            <div class="form-group">

                @Html.LabelFor(m => m.Email)

                <div class="input-wrapper">

                    <span class="input-icon">✉</span>

                    @Html.TextBoxFor(
                        m => m.Email,
                        new
                        {
                            @class = "form-control",
                            type = "email",
                            placeholder = "Enter your email",
                            autocomplete = "email"
                        }
                    )

                </div>

                @Html.ValidationMessageFor(
                    m => m.Email,
                    "",
                    new { @class = "text-danger" }
                )

            </div>


            <!-- Password -->
            <div class="form-group">

                @Html.LabelFor(m => m.Password)

                <div class="input-wrapper">

                    <span class="input-icon">🔒</span>

                    @Html.PasswordFor(
                        m => m.Password,
                        new
                        {
                            @class = "form-control",
                            placeholder = "Enter your password",
                            autocomplete = "current-password"
                        }
                    )

                </div>

                @Html.ValidationMessageFor(
                    m => m.Password,
                    "",
                    new { @class = "text-danger" }
                )

            </div>


            <!-- Forgot Password -->
            <div class="forgot-password">

                <a href="@Url.Action("ForgotPassword", "Account")" style="color:#e50914;font-size:12px;font-weight:700;text-decoration:none;">
                    Forgot password?
                </a>
            </div>


            <!-- Login Button -->
            <button type="submit" class="login-btn">
                Login
            </button>
        }


        <!-- Registration -->
        <p class="register-link">

            Don't have an account?

            <a href="@Url.Action("Registration", "Account")">
                Create Account
            </a>

        </p>


        <div class="login-footer">
            © @DateTime.Now.Year ShoppingApplication. All rights reserved.
        </div>

    </div>

</div>
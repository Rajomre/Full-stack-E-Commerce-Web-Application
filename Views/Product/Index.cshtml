@model IEnumerable<Shoping_webapplication_project_.Models.Product>

@{
    ViewBag.Title = "Product Catalog";
    Layout = "~/Views/Shared/UserDashboardLayout.cshtml";
    var categories = ViewBag.Categories as List<string> ?? new List<string>();
    var currentCategory = ViewBag.CurrentCategory as string ?? "All";
    var currentSearch = ViewBag.CurrentSearch as string ?? "";
}

<style>
    /* Catalog Header */
    .catalog-header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        flex-wrap: wrap;
        gap: 15px;
        margin-bottom: 24px;
    }

    .catalog-title h1 {
        font-size: 26px;
        font-weight: 800;
        margin: 0 0 5px;
        color: #111;
    }

    .catalog-title p {
        margin: 0;
        font-size: 13px;
        color: #777;
    }

    /* Filter Bar */
    .filter-wrapper {
        background: #fff;
        border-radius: 16px;
        padding: 16px 20px;
        margin-bottom: 25px;
        border: 1px solid rgba(0, 0, 0, 0.06);
        box-shadow: 0 4px 20px rgba(0, 0, 0, 0.03);
        display: flex;
        align-items: center;
        justify-content: space-between;
        flex-wrap: wrap;
        gap: 15px;
    }

    .category-pills {
        display: flex;
        align-items: center;
        gap: 8px;
        flex-wrap: wrap;
    }

    .pill-btn {
        padding: 7px 16px;
        border-radius: 20px;
        font-size: 12px;
        font-weight: 600;
        background: #f1f2f4;
        color: #555;
        transition: all 0.2s ease;
        border: 1px solid transparent;
    }

        .pill-btn:hover {
            background: #e5e7eb;
            color: #111;
        }

        .pill-btn.active {
            background: #e50914;
            color: #fff;
            box-shadow: 0 4px 14px rgba(229, 9, 20, 0.3);
        }

    .search-filter-form {
        display: flex;
        align-items: center;
        gap: 8px;
    }

    .search-input-field {
        height: 38px;
        padding: 0 14px;
        border-radius: 10px;
        border: 1px solid #ddd;
        font-size: 13px;
        outline: none;
        width: 220px;
        transition: 0.2s ease;
    }

        .search-input-field:focus {
            border-color: #e50914;
        }

    .search-submit-btn {
        height: 38px;
        padding: 0 16px;
        border-radius: 10px;
        background: #111;
        color: #fff;
        border: none;
        font-size: 12px;
        font-weight: 600;
        cursor: pointer;
        transition: 0.2s ease;
    }

        .search-submit-btn:hover {
            background: #e50914;
        }

    /* Products Grid */
    .products-grid {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(250px, 1fr));
        gap: 22px;
    }

    .product-card {
        background: #fff;
        border-radius: 18px;
        overflow: hidden;
        border: 1px solid rgba(0, 0, 0, 0.06);
        box-shadow: 0 4px 18px rgba(0, 0, 0, 0.04);
        transition: all 0.25s ease;
        display: flex;
        flex-direction: column;
    }

        .product-card:hover {
            transform: translateY(-5px);
            box-shadow: 0 12px 30px rgba(0, 0, 0, 0.08);
            border-color: rgba(229, 9, 20, 0.2);
        }

    /* Image Wrapper */
    .product-image-box {
        width: 100%;
        height: 210px;
        background: #f7f7f8;
        display: flex;
        align-items: center;
        justify-content: center;
        position: relative;
        overflow: hidden;
    }

        .product-image-box img {
            width: 100%;
            height: 100%;
            object-fit: cover;
            transition: transform 0.3s ease;
        }

    .product-card:hover .product-image-box img {
        transform: scale(1.05);
    }

    .no-img-placeholder {
        color: #aaa;
        font-size: 12px;
        font-weight: 600;
        text-align: center;
        padding: 20px;
    }

    .category-tag {
        position: absolute;
        top: 12px;
        left: 12px;
        background: rgba(14, 14, 14, 0.75);
        color: #fff;
        padding: 4px 10px;
        border-radius: 12px;
        font-size: 10px;
        font-weight: 700;
        letter-spacing: 0.5px;
        backdrop-filter: blur(8px);
    }

    /* Product Info */
    .product-details {
        padding: 18px;
        display: flex;
        flex-direction: column;
        flex: 1;
    }

    .product-name {
        font-size: 15px;
        font-weight: 700;
        color: #111;
        margin: 0 0 8px;
        line-height: 1.3;
        display: -webkit-box;
        -webkit-line-clamp: 2;
        -webkit-box-orient: vertical;
        overflow: hidden;
    }

    .product-pricing-stock {
        display: flex;
        align-items: baseline;
        justify-content: space-between;
        margin-top: auto;
        padding-top: 12px;
    }

    .product-price {
        font-size: 18px;
        font-weight: 800;
        color: #e50914;
    }

    .stock-badge {
        font-size: 11px;
        font-weight: 700;
        padding: 3px 8px;
        border-radius: 6px;
    }

    .stock-in {
        background: #e8f7ee;
        color: #1a8742;
    }

    .stock-out {
        background: #fde8e8;
        color: #e50914;
    }

    /* Card Action Buttons */
    .product-card-actions {
        display: flex;
        gap: 8px;
        padding: 0 18px 18px;
    }

    .btn-view-details {
        flex: 1;
        text-align: center;
        padding: 9px 0;
        border-radius: 10px;
        font-size: 12px;
        font-weight: 700;
        background: #f5f5f5;
        color: #333;
        border: 1px solid rgba(0, 0, 0, 0.06);
        transition: 0.2s ease;
    }

        .btn-view-details:hover {
            background: #111;
            color: #fff;
        }

    .btn-add-cart {
        flex: 1;
        text-align: center;
        padding: 9px 0;
        border-radius: 10px;
        font-size: 12px;
        font-weight: 700;
        background: #e50914;
        color: #fff;
        border: none;
        transition: 0.2s ease;
        cursor: pointer;
    }

        .btn-add-cart:hover {
            background: #b20710;
            color: #fff;
        }

        .btn-add-cart:disabled {
            background: #ccc;
            cursor: not-allowed;
        }

    /* Empty Catalog */
    .empty-catalog {
        text-align: center;
        padding: 60px 20px;
        background: #fff;
        border-radius: 18px;
        border: 1px dashed #ddd;
    }

        .empty-catalog h3 {
            margin: 0 0 8px;
            color: #222;
            font-size: 18px;
        }

        .empty-catalog p {
            color: #777;
            font-size: 13px;
            margin: 0 0 18px;
        }
</style>

<!-- Catalog Header -->
<div class="catalog-header">
    <div class="catalog-title">
        <h1>Product Catalog</h1>
        <p>Browse through our collection of verified products.</p>
    </div>
</div>

<!-- Filters & Search -->
<div class="filter-wrapper">
    <div class="category-pills">
        <a href="@Url.Action("Index", "Product", new { category = "All", search = currentSearch })"
           class="pill-btn @(currentCategory == "All" ? "active" : "")">
            All Products
        </a>
        @foreach (var cat in categories)
        {
            <a href="@Url.Action("Index", "Product", new { category = cat, search = currentSearch })"
               class="pill-btn @(currentCategory == cat ? "active" : "")">
                @cat
            </a>
        }
    </div>

    @using (Html.BeginForm("Index", "Product", FormMethod.Get, new { @class = "search-filter-form" }))
    {
        <input type="hidden" name="category" value="@currentCategory" />
        <input type="text" name="search" value="@currentSearch"
               placeholder="Search product..." class="search-input-field" />
        <button type="submit" class="search-submit-btn">Search</button>
    }
</div>

<!-- Products Grid -->
@if (Model != null && Model.Any())
{
    <div class="products-grid">
        @foreach (var item in Model)
        {
            <div class="product-card">
                <div class="product-image-box">
                    @if (!string.IsNullOrEmpty(item.ImageUrl))
                    {
                        <img src="@Url.Content(item.ImageUrl)" alt="@item.ProductName"
                             onerror="this.onerror=null;this.parentElement.innerHTML='<div class=\'no-img-placeholder\'>Image Not Available</div>';" />
                    }
                    else
                    {
                        <div class="no-img-placeholder">Image Not Available</div>
                    }

                    @if (!string.IsNullOrEmpty(item.Category))
                    {
                        <span class="category-tag">@item.Category</span>
                    }
                </div>

                <div class="product-details">
                    <h3 class="product-name" title="@item.ProductName">@item.ProductName</h3>

                    <div class="product-pricing-stock">
                        <span class="product-price">&#8377;@item.Price.ToString("N2")</span>

                        @if (item.StockQuantity > 0)
                        {
                            <span class="stock-badge stock-in">In Stock (@item.StockQuantity)</span>
                        }
                        else
                        {
                            <span class="stock-badge stock-out">Out of Stock</span>
                        }
                    </div>
                </div>

                <div class="product-card-actions">
                    <a href="@Url.Action("Details", "Product", new { id = item.ProductId })" class="btn-view-details">
                        View Details
                    </a>
                    @if (item.StockQuantity > 0)
                    {
                        using (Html.BeginForm("AddToCart", "Cart", FormMethod.Post, new { style = "flex: 1;" }))
                        {
                            <input type="hidden" name="productId" value="@item.ProductId" />
                            <input type="hidden" name="quantity" value="1" />
                            <button type="submit" class="btn-add-cart" style="width: 100%;">
                                Add to Cart
                            </button>
                        }
                        using (Html.BeginForm("Add", "Wishlist", FormMethod.Post, new { style = "display:inline;" }))
                        {
                            <input type="hidden" name="productId" value="@item.ProductId" />
                            <button type="submit" style="height:36px;width:36px;border-radius:8px;border:1px solid #ddd;background:#fff;cursor:pointer;color:#e50914;font-size:16px;" title="Add to Wishlist">
                                &hearts;
                            </button>
                        }
                    }
                    else
                    {
                        <button type="button" class="btn-add-cart" disabled>
                            Sold Out
                        </button>
                    }
                </div>
            </div>
        }
    </div>
}
else
{
    <div class="empty-catalog">
        <h3>No Products Found</h3>
        <p>There are no active products available matching your search or category filter.</p>
        <a href="@Url.Action("Index", "Product")" class="pill-btn active">View All Products</a>
    </div>
}
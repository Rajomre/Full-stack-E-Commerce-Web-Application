@model Shoping_webapplication_project_.ViewModels.AdminReportsViewModel

@{
    ViewBag.Title = "Reports";
    Layout = "~/Views/Shared/LoginLayout.cshtml";
}

<style>
    .reports-container {
        padding: 30px;
    }

    .page-header {
        margin-bottom: 25px;
    }

        .page-header h2 {
            margin: 0;
            font-size: 28px;
            font-weight: 700;
        }

        .page-header p {
            color: #777;
            margin-top: 6px;
        }

    .filter-card {
        background: #fff;
        padding: 22px;
        border-radius: 12px;
        box-shadow: 0 4px 15px rgba(0,0,0,0.08);
        margin-bottom: 25px;
    }

    .filter-form {
        display: flex;
        align-items: end;
        gap: 15px;
        flex-wrap: wrap;
    }

    .filter-group {
        display: flex;
        flex-direction: column;
        gap: 6px;
    }

        .filter-group label {
            font-size: 13px;
            font-weight: 600;
        }

        .filter-group input {
            padding: 10px 12px;
            border: 1px solid #ddd;
            border-radius: 7px;
        }

    .generate-btn {
        background: #111;
        color: #fff;
        border: none;
        padding: 10px 20px;
        border-radius: 7px;
        cursor: pointer;
        font-weight: 600;
    }

        .generate-btn:hover {
            background: #d60000;
        }

    .reset-btn {
        padding: 10px 20px;
        border-radius: 7px;
        border: 1px solid #ddd;
        text-decoration: none;
        color: #333;
    }

    .stats-grid {
        display: grid;
        grid-template-columns: repeat(4, 1fr);
        gap: 20px;
        margin-bottom: 25px;
    }

    .stat-card {
        background: #fff;
        padding: 22px;
        border-radius: 12px;
        box-shadow: 0 4px 15px rgba(0,0,0,0.08);
    }

    .stat-title {
        color: #777;
        font-size: 14px;
        margin-bottom: 10px;
    }

    .stat-value {
        font-size: 27px;
        font-weight: 700;
    }

    .orders-card {
        background: #fff;
        padding: 25px;
        border-radius: 12px;
        box-shadow: 0 4px 15px rgba(0,0,0,0.08);
    }

        .orders-card h3 {
            margin-top: 0;
            margin-bottom: 20px;
        }

    .orders-table {
        width: 100%;
        border-collapse: collapse;
    }

        .orders-table th,
        .orders-table td {
            padding: 13px;
            border-bottom: 1px solid #eee;
            text-align: left;
        }

        .orders-table th {
            background: #111;
            color: #fff;
        }

    .status {
        font-weight: 600;
    }

    .empty-message {
        text-align: center;
        padding: 30px;
        color: #777;
    }

    @@media (max-width: 1000px) {
        .stats-grid {
            grid-template-columns: repeat(2, 1fr);
        }
    }

    @@media (max-width: 600px) {
        .stats-grid {
            grid-template-columns: 1fr;
        }

        .reports-container {
            padding: 15px;
        }
    }
</style>

<div class="reports-container">

    <div class="page-header">
        <h2>Reports</h2>
        <p>Analyze orders, sales and revenue from your store.</p>
    </div>

    <div class="page-header">
        <div>
            <h1>Reports</h1>
            <p>Analyze orders, sales and revenue.</p>
        </div>

        <a href="@Url.Action("Index", "Admin")" class="btn btn-outline-danger">
            ← Back to Dashboard
        </a>
    </div>
    <!-- Date Filter -->
    <div class="filter-card">

        <form method="get"
              action="@Url.Action("Reports", "Admin")"
              class="filter-form">

            <div class="filter-group">
                <label>From Date</label>
                <input type="date"
                       name="fromDate"
                       value="@(Model.FromDate.HasValue ? Model.FromDate.Value.ToString("yyyy-MM-dd") : "")" />
            </div>

            <div class="filter-group">
                <label>To Date</label>
                <input type="date"
                       name="toDate"
                       value="@(Model.ToDate.HasValue ? Model.ToDate.Value.ToString("yyyy-MM-dd") : "")" />
            </div>

            <button type="submit" class="generate-btn">
                Generate Report
            </button>

            <a href="@Url.Action("Reports", "Admin")"
               class="reset-btn">
                Reset
            </a>

        </form>

    </div>

    <!-- Statistics -->
    <div class="stats-grid">

        <div class="stat-card">
            <div class="stat-title">Total Orders</div>
            <div class="stat-value">
                @Model.TotalOrders
            </div>
        </div>

        <div class="stat-card">
            <div class="stat-title">Items Sold</div>
            <div class="stat-value">
                @Model.TotalItemsSold
            </div>
        </div>

        <div class="stat-card">
            <div class="stat-title">Total Revenue</div>
            <div class="stat-value">
                ₹@Model.TotalRevenue.ToString("N2")
            </div>
        </div>

        <div class="stat-card">
            <div class="stat-title">Delivered Orders</div>
            <div class="stat-value">
                @Model.DeliveredOrders
            </div>
        </div>

    </div>

    <!-- Status Summary -->
    <div class="stats-grid">

        <div class="stat-card">
            <div class="stat-title">Pending Orders</div>
            <div class="stat-value">
                @Model.PendingOrders
            </div>
        </div>

        <div class="stat-card">
            <div class="stat-title">Processing Orders</div>
            <div class="stat-value">
                @Model.ProcessingOrders
            </div>
        </div>

        <div class="stat-card">
            <div class="stat-title">Shipped Orders</div>
            <div class="stat-value">
                @Model.ShippedOrders
            </div>
        </div>

        <div class="stat-card">
            <div class="stat-title">Delivered Orders</div>
            <div class="stat-value">
                @Model.DeliveredOrders
            </div>
        </div>

    </div>

    <!-- Orders Report -->
    <div class="orders-card">

        <h3>Order Report</h3>

        @if (Model.Orders != null && Model.Orders.Any())
        {
            <table class="orders-table">

                <thead>
                    <tr>
                        <th>Order ID</th>
                        <th>Customer</th>
                        <th>Items</th>
                        <th>Amount</th>
                        <th>Status</th>
                        <th>Order Date</th>
                    </tr>
                </thead>

                <tbody>

                    @foreach (var order in Model.Orders)
                    {
                        <tr>
                            <td>@order.OrderNumber</td>

                            <td>@order.CustomerName</td>

                            <td>@order.TotalItems</td>

                            <td>
                                ₹@order.TotalAmount.ToString("N2")
                            </td>

                            <td class="status">
                                @order.Status
                            </td>

                            <td>
                                @order.OrderDate.ToString("dd MMM yyyy")
                            </td>
                        </tr>
                    }

                </tbody>

            </table>
        }
        else
        {
            <div class="empty-message">
                No orders found for the selected date range.
            </div>
        }

    </div>
    <!-- Monthly Sales Report -->
    <div class="orders-card" style="margin-bottom:25px;">

        <h3>Monthly Sales Report</h3>

        @if (Model.MonthlySales != null && Model.MonthlySales.Any())
        {
            <table class="orders-table">

                <thead>
                    <tr>
                        <th>Month</th>
                        <th>Total Orders</th>
                        <th>Items Sold</th>
                        <th>Total Revenue</th>
                    </tr>
                </thead>

                <tbody>

                    @foreach (var month in Model.MonthlySales)
                    {
                        <tr>
                            <td>@month.Month</td>

                            <td>
                                @month.TotalOrders
                            </td>

                            <td>
                                @month.TotalItemsSold
                            </td>

                            <td>
                                ₹@month.TotalRevenue.ToString("N2")
                            </td>
                        </tr>
                    }

                </tbody>

            </table>
        }
        else
        {
            <div class="empty-message">
                No monthly sales data available.
            </div>
        }

    </div>

</div>
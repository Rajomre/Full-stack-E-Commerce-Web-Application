@model Shoping_webapplication_project_.Models.Product

@{
    ViewBag.Title = "Product Details";
    Layout = "~/Views/Shared/LoginLayout.cshtml";
}

<style>
    .product-details-page {
        padding: 30px;
        background: #f7f7f7;
        min-height: calc(100vh - 70px);
    }

    .details-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 25px;
    }

    .details-header h1 {
        margin: 0;
        font-size: 28px;
        color: #111;
    }

    .details-header p {
        margin-top: 6px;
        color: #777;
    }

    .back-btn {
        background: #111;
        color: white;
        text-decoration: none;
        padding: 10px 18px;
        border-radius: 7px;
        font-weight: 600;
    }

    .product-card {
        max-width: 1000px;
        background: white;
        border-radius: 12px;
        padding: 30px;
        box-shadow: 0 3px 15px rgba(0,0,0,.07);
    }

    .product-top {
        display: flex;
        gap: 30px;
        padding-bottom: 25px;
        border-bottom: 1px solid #eee;
    }

    .product-image {
        width: 280px;
        height: 280px;
        border-radius: 10px;
        background: #f1f1f1;
        display: flex;
        align-items: center;
        justify-content: center;
        overflow: hidden;
        flex-shrink: 0;
    }

    .product-image img {
        width: 100%;
        height: 100%;
        object-fit: cover;
    }

    .no-image {
        color: #888;
        font-size: 14px;
    }

    .product-info {
        flex: 1;
    }

    .product-info h2 {
        margin-top: 0;
        margin-bottom: 10px;
        font-size: 26px;
        color: #111;
    }

    .category {
        display: inline-block;
        background: #f1f1f1;
        color: #555;
        padding: 6px 12px;
        border-radius: 20px;
        font-size: 12px;
        font-weight: 600;
        margin-bottom: 15px;
    }

    .description {
        color: #666;
        line-height: 1.7;
        margin-bottom: 20px;
    }

    .price {
        font-size: 25px;
        font-weight: 700;
        color: #dc3545;
    }

    .details-grid {
        display: grid;
        grid-template-columns: repeat(2, 1fr);
        gap: 18px;
        margin-top: 25px;
    }

    .detail-box {
        background: #f8f8f8;
        padding: 18px;
        border-radius: 8px;
    }

    .detail-label {
        display: block;
        color: #888;
        font-size: 12px;
        margin-bottom: 6px;
    }

    .detail-value {
        color: #111;
        font-weight: 600;
        font-size: 15px;
    }

    .status {
        display: inline-block;
        padding: 6px 12px;
        border-radius: 20px;
        font-size: 12px;
        font-weight: 600;
    }

    .status.active {
        background: #e8f7ee;
        color: #198754;
    }

    .status.inactive {
        background: #f8e8e8;
        color: #dc3545;
    }

    .action-buttons {
        margin-top: 25px;
        display: flex;
        gap: 10px;
    }

    .edit-btn {
        background: #dc3545;
        color: white;
        text-decoration: none;
        padding: 11px 20px;
        border-radius: 7px;
        font-weight: 600;
    }

    .products-btn {
        background: #111;
        color: white;
        text-decoration: none;
        padding: 11px 20px;
        border-radius: 7px;
        font-weight: 600;
    }
    .delete-btn {
        background: #dc2626;
        color: #fff;
        border: none;
        padding: 12px 20px;
        border-radius: 8px;
        cursor: pointer;
        font-size: 14px;
        font-weight: 600;
    }

        .delete-btn:hover {
            background: #b91c1c;
        }
    .status-btn {
        border: none;
        padding: 12px 20px;
        border-radius: 8px;
        cursor: pointer;
        font-size: 14px;
        font-weight: 600;
    }

    .deactivate-btn {
        background: #444;
        color: #fff;
    }

        .deactivate-btn:hover {
            background: #222;
        }

    .activate-btn {
        background: #16a34a;
        color: #fff;
    }

        .activate-btn:hover {
            background: #15803d;
        }

    @@media (max-width: 768px) {

        .product-details-page {
            padding: 20px 15px;
        }

        .details-header {
            flex-wrap: wrap;
            gap: 15px;
        }

        .product-top {
            flex-direction: column;
        }

        .product-image {
            width: 100%;
            height: 250px;
        }

        .details-grid {
            grid-template-columns: 1fr;
        }
    }
</style>


<div class="product-details-page">

    <div class="details-header">

        <div>
            <h1>Product Details</h1>
            <p>View complete product information.</p>
        </div>

        <a href="@Url.Action("Products", "Admin")"
           class="back-btn">
            ← Products
        </a>

    </div>


    <div class="product-card">

        <div class="product-top">

            <div class="product-image">

                @if (!string.IsNullOrWhiteSpace(Model.ImageUrl))
                {
                    <img src="@Model.ImageUrl"
                         alt="@Model.ProductName" />
                }
                else
                {
                    <span class="no-image">
                        No Image Available
                    </span>
                }

            </div>


            <div class="product-info">

                <h2>
                    @Model.ProductName
                </h2>

                <span class="category">
                    @Model.Category
                </span>

                <div class="description">
                    @Model.Description
                </div>

                <div class="price">
                    ₹@Model.Price.ToString("N2")
                </div>

            </div>

        </div>


        <div class="details-grid">

            <div class="detail-box">

                <span class="detail-label">
                    Product ID
                </span>

                <span class="detail-value">
                    @Model.ProductId
                </span>

            </div>


            <div class="detail-box">

                <span class="detail-label">
                    Stock Quantity
                </span>

                <span class="detail-value">
                    @Model.StockQuantity
                </span>

            </div>


            <div class="detail-box">

                <span class="detail-label">
                    Category
                </span>

                <span class="detail-value">
                    @Model.Category
                </span>

            </div>


            <div class="detail-box">

                <span class="detail-label">
                    Status
                </span>

                <span class="detail-value">

                    @if (Model.IsActive)
                    {
                        <span class="status active">
                            Active
                        </span>
                    }
                    else
                    {
                        <span class="status inactive">
                            Inactive
                        </span>
                    }

                </span>

            </div>


            <div class="detail-box">

                <span class="detail-label">
                    Created At
                </span>

                <span class="detail-value">
                    @Model.CreatedAt.ToString("dd MMM yyyy hh:mm tt")
                </span>

            </div>

        </div>


        <div class="action-buttons">

            <a href="@Url.Action("EditProduct", "Admin", new { id = Model.ProductId })"
               class="edit-btn">
                Edit Product
            </a>
            @using (Html.BeginForm("DeleteProduct", "Admin",
    new { id = Model.ProductId },
    FormMethod.Post,
    new { onsubmit = "return confirm('Are you sure you want to delete this product?');" }))
            {
                @Html.AntiForgeryToken()

                <button type="submit" class="delete-btn">
                    Delete Product
                </button>
            }
            @using (Html.BeginForm("ToggleProductStatus", "Admin",
    new { id = Model.ProductId },
    FormMethod.Post,
    new
    {
        onsubmit = "return confirm('Are you sure you want to change this product status?');"
    }))
            {
                @Html.AntiForgeryToken()

                if (Model.IsActive)
                {
                    <button type="submit" class="status-btn deactivate-btn">
                        Deactivate Product
                    </button>
                }
                else
                {
                    <button type="submit" class="status-btn activate-btn">
                        Activate Product
                    </button>
                }
            }

            <a href="@Url.Action("Products", "Admin")"
               class="products-btn">
                Back to Products
            </a>

        </div>

    </div>

</div>
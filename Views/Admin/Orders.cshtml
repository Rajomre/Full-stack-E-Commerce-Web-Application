@model IEnumerable<Shoping_webapplication_project_.ViewModels.AdminOrderViewModel>

@{
    ViewBag.Title = "Orders";
    Layout = "~/Views/Shared/LoginLayout.cshtml";
}

<div class="orders-page">

    <div class="page-header">
        <div>
            <h1>Order Management</h1>
            <p>Manage and monitor customer orders.</p>
        </div>

        <a href="@Url.Action("Index", "Admin")" class="dashboard-btn">
            ← Dashboard
        </a>
    </div>

    <div class="orders-card">
        <div class="filter-section">

            <form method="get" action="@Url.Action("Orders", "Admin")">

                <input type="text"
                       name="search"
                       value="@Request.QueryString["search"]"
                       placeholder="Search Order Number or Customer Name..."
                       class="search-box" />

                <select name="status" class="status-filter">

                    <option value="">All Status</option>

                    <option value="Pending"
                            @(Request.QueryString["status"] == "Pending" ? "selected" : "")>
                        Pending
                    </option>

                    <option value="Processing"
                            @(Request.QueryString["status"] == "Processing" ? "selected" : "")>
                        Processing
                    </option>

                    <option value="Shipped"
                            @(Request.QueryString["status"] == "Shipped" ? "selected" : "")>
                        Shipped
                    </option>

                    <option value="Delivered"
                            @(Request.QueryString["status"] == "Delivered" ? "selected" : "")>
                        Delivered
                    </option>

                </select>

                <button type="submit" class="filter-btn">
                    Search
                </button>

                <a href="@Url.Action("Orders", "Admin")" class="clear-btn">
                    Clear
                </a>

            </form>

        </div>

        <table class="orders-table">

            <thead>
                <tr>
                    <th>Order ID</th>
                    <th>Customer</th>
                    <th>Items</th>
                    <th>Amount</th>
                    <th>Status</th>
                    <th>Order Date</th>
                    <th>Action</th>
                </tr>
            </thead>

            <tbody>

                @foreach (var order in Model)
                {
                    <tr>
                        <td>
                            <strong>@order.OrderId</strong>
                        </td>

                        <td>
                            @order.CustomerName
                        </td>

                        <td>
                            @order.TotalItems
                        </td>

                        <td>
                            ₹@order.TotalAmount.ToString("N2")
                        </td>

                        <td>
                            <span class="status @order.Status.ToLower()">
                                @order.Status
                            </span>
                        </td>

                        <td>
                            @order.OrderDate.ToString("dd MMM yyyy")
                        </td>


                        <td>
                            <a href="@Url.Action("OrderDetails", "Admin", new { id = order.DatabaseOrderId })"
                               class="view-btn">
                                View Details
                            </a>
                        </td>
                    </tr>
                }

            </tbody>

        </table>

    </div>

</div>

<style>

    .orders-page {
        padding: 30px;
    }

    .page-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 25px;
    }

    .page-header h1 {
        margin: 0;
        font-size: 28px;
    }

    .page-header p {
        margin-top: 6px;
        color: #777;
    }

    .dashboard-btn {
        background: #111;
        color: white;
        padding: 11px 18px;
        border-radius: 8px;
        text-decoration: none;
    }

    .orders-card {
        background: #fff;
        border-radius: 12px;
        padding: 20px;
        box-shadow: 0 4px 20px rgba(0,0,0,.08);
        overflow-x: auto;
    }

    .orders-table {
        width: 100%;
        border-collapse: collapse;
    }

    .orders-table th,
    .orders-table td {
        padding: 15px;
        text-align: left;
        border-bottom: 1px solid #eee;
    }

    .orders-table th {
        background: #111;
        color: #fff;
    }

    .status {
        padding: 6px 11px;
        border-radius: 20px;
        font-size: 12px;
        font-weight: 600;
    }

    .delivered {
        background: #dcfce7;
        color: #166534;
    }

    .processing {
        background: #fef3c7;
        color: #92400e;
    }

    .shipped {
        background: #dbeafe;
        color: #1e40af;
    }

    .pending {
        background: #fee2e2;
        color: #991b1b;
    }

    .view-btn {
        background: #e11d48;
        color: #fff;
        border: none;
        padding: 8px 14px;
        border-radius: 6px;
        cursor: pointer;
    }

    .filter-section {
        margin-bottom: 20px;
    }

        .filter-section form {
            display: flex;
            gap: 12px;
            align-items: center;
            flex-wrap: wrap;
        }

    .search-box {
        flex: 1;
        min-width: 250px;
        padding: 11px 14px;
        border: 1px solid #ddd;
        border-radius: 7px;
        font-size: 14px;
    }

    .status-filter {
        padding: 11px 14px;
        border: 1px solid #ddd;
        border-radius: 7px;
        background: white;
        font-size: 14px;
    }

    .filter-btn {
        background: #e11d48;
        color: white;
        border: none;
        padding: 11px 18px;
        border-radius: 7px;
        cursor: pointer;
    }

    .clear-btn {
        background: #111;
        color: white;
        padding: 11px 18px;
        border-radius: 7px;
        text-decoration: none;
    }

</style>